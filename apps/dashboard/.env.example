# ================================================
# BridgeAPI Dashboard — Environment
# ================================================

# REQUIRED: PostgreSQL connection string (same as Gateway)
DATABASE_URL="postgresql://user:password@localhost:5432/bridgeapi?schema=public"

# REQUIRED: Gateway URL
GATEWAY_URL="http://localhost:3001"

# OPTIONAL: NextAuth secret
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
