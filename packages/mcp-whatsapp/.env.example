# ==============================================
# BridgeAPI WhatsApp MCP Server — Environment
# ==============================================
# Get these from: Meta Business Manager → WhatsApp → API Setup
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

# REQUIRED: System User Token (permanent token recommended)
WHATSAPP_ACCESS_TOKEN=

# REQUIRED: Phone Number ID (from the WhatsApp > Getting Started page)
WHATSAPP_PHONE_NUMBER_ID=

# REQUIRED: WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=

# OPTIONAL: API version (default: v21.0)
# WHATSAPP_API_VERSION=v21.0
